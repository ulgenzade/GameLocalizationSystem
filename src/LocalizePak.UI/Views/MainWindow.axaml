<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalizePak.UI.ViewModels"
        xmlns:loc="using:LocalizePak.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dg="using:Avalonia.Controls"
        mc:Ignorable="d"
        x:Class="LocalizePak.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Loc App_Title}"
        Icon="/Assets/glslogo.ico"
        Width="1420" Height="880"
        MinWidth="1280" MinHeight="740"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur"
        DragDrop.AllowDrop="True">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- KLAVYE KISAYOLLARI (HOTKEYS)                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding PrimaryActionCommand}"/>
        <KeyBinding Gesture="F6" Command="{Binding ResumeTranslationCommand}"/>
        <KeyBinding Gesture="F7" Command="{Binding RunQaCheckCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleFindReplaceCommand}"/>
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ToggleFindReplaceCommand}"/>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding PrimaryActionCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RetryErrorsCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding TranslateSelectedCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding CancelTranslationCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenPakCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenSingleFileCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportToTimestampedFolderCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SavePakDirectCommand}"/>
    </Window.KeyBindings>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 / WINDOWS 11 FLUENT 2 ANA DÜZEN                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource WindowBackgroundBrush}" DragDrop.AllowDrop="True">

        <!-- ─── 1. WINUI 3 BAŞLIK ÇUBUĞU & MENÜ BARI ─── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="True">

                <!-- Sağ Üst: Aktif AI InfoBadge & Düşünme Modu (Sağ Kenara Kilitli) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,4,0">
                    <Border Background="#18FFFFFF" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Engine_Label}" Classes="caption" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedProviderName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#18FFFFFF" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🧠" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Reasoning_Label}" Classes="caption" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.ReasoningEffortOptions}"
                                      SelectedItem="{Binding SelectedReasoningEffort}"
                                      Width="175"
                                      ToolTip.Tip="{loc:Loc Reasoning_Tooltip}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sol: Logo & Menü Çubuğu -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- Logo & GLS Başlık -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Background="#1AFFFFFF" CornerRadius="8" Width="30" Height="30" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="GLS" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc App_Subtitle}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- WinUI 3 Menü Çubuğu -->
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="{loc:Loc Menu_File}">
                            <MenuItem Header="{loc:Loc Menu_File_OpenPak}" Command="{Binding OpenPakCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_File_OpenSingle}" Command="{Binding OpenSingleFileCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_File_AddExternal}" Command="{Binding AddExternalFileCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_File_Close}" Command="{Binding CloseCurrentFileCommand}" IsEnabled="{Binding IsPakLoaded}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_File_ExportFolder}" Command="{Binding ExportToTimestampedFolderCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_File_OpenFolder}" Command="{Binding OpenOutputFolderCommand}" IsEnabled="{Binding HasExportedDirectory}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_File_ExportCsv}" Command="{Binding ExportTranslationsCsvCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_File_ImportCsv}" Command="{Binding ImportTranslationsCsvCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_File_SavePak}" Command="{Binding SavePakDirectCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_File_ExportPatch}" Command="{Binding ExportPatchCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_File_Exit}" Click="OnExitClick"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_Edit}">
                            <MenuItem Header="{loc:Loc Menu_Edit_FindReplace}" Command="{Binding ToggleFindReplaceCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Edit_CopySource}" Command="{Binding CopySourceCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Edit_CopyTranslation}" Command="{Binding CopyTranslationCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Edit_CopySourceToTranslation}" Command="{Binding CopySourceToTranslationCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Edit_SelectAll}" Command="{Binding SelectAllFilteredCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Edit_DeselectAll}" Command="{Binding DeselectAllCommand}"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_Translation}">
                            <MenuItem Header="{loc:Loc Menu_Trans_StartStop}" Command="{Binding PrimaryActionCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Trans_Resume}" Command="{Binding ResumeTranslationCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Trans_Cancel}" Command="{Binding CancelTranslationCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Trans_RunQa}" Command="{Binding RunQaCheckCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Trans_AutoFix}" Command="{Binding AutoFixAllQaIssuesCommand}"/>
                            <MenuItem Header="{loc:Loc Menu_Trans_Pseudo}" Command="{Binding ApplyPseudolocalizationCommand}" ToolTip.Tip="{loc:Loc Menu_Trans_Pseudo_Tooltip}"/>
                            <MenuItem Header="{loc:Loc Menu_Trans_Retranslate}" Command="{Binding RetranslateSingleCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Trans_ExportErrors}" Command="{Binding ExportErrorsCsvCommand}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Trans_Glossary}" Click="OnGlossaryClick"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_Settings}">
                            <MenuItem Header="{loc:Loc Menu_Settings_Config}" Click="OnSettingsClick"/>
                            <MenuItem Header="{loc:Loc Menu_Trans_Glossary}" Click="OnGlossaryClick"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Settings_ClearTM}" Command="{Binding ClearTranslationMemoryCommand}"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_Help}">
                            <MenuItem Header="{loc:Loc Menu_Help_Guide}" Click="OnLocalizationGuideClick"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Help_KeyVault}" Click="OnAesKeyVaultClick"/>
                            <MenuItem Header="{loc:Loc Menu_Help_RamExtractor}" Click="OnRamAesExtractorClick"/>
                            <MenuItem Header="{loc:Loc Menu_Help_AiAssistant}" Click="OnAiAesAssistantClick"/>
                            <MenuItem Header="{loc:Loc Menu_Help_AesHelp}" Click="OnAesHelpClick"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Help_Workflow}" Click="OnHelpClick"/>
                            <MenuItem Header="{loc:Loc Menu_Help_About}" Click="OnAboutClick"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── 2. ANA GÖVDE (SEKMELİ NAVIGATION PANE + SEKMELİ MERKEZİ ÇALIŞMA ALANI) ─── -->
        <Grid Grid.Row="1" ColumnDefinitions="310,1,*">

            <!-- ─── SOL PANEL (WINUI 3 SEKMELİ NAVIGATION PANE) ─── -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" Padding="10,8">
                <TabControl>

                    <!-- Sekme 1: Paket & Dosya İşlemleri -->
                    <TabItem Header="{loc:Loc Tab_Pak}">
                        <ScrollViewer Margin="0,8,0,0">
                            <StackPanel Spacing="10">

                                <!-- Yüklü Paket Bilgi Kartı (Başarılı: En az 1 lokalizasyon dosyası var) -->
                                <Border Classes="infobar-success" IsVisible="{Binding HasLocalizationFiles}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="📦" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LoadedPakFileName}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#4CAF50"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding LoadedPakFileName}"/>
                                            <Border Grid.Column="2" Background="#26FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LoadedPakSizeInfo}" FontSize="10" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                            </Border>
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Classes="subtle"
                                                    Padding="6,2"
                                                    FontSize="12"
                                                    Foreground="#FF6B6B"
                                                    Command="{Binding CloseCurrentFileCommand}"
                                                    ToolTip.Tip="Mevcut paketi/dosyayı kapat"/>
                                        </Grid>
                                        <TextBlock Text="{Binding PakEntries.Count, StringFormat='{}✅ {0} lokalizasyon dosyası başarıyla ayrıştırıldı ve hazır'}"
                                                   FontSize="11" Foreground="#A5D6A7"/>
                                    </StackPanel>
                                </Border>

                                <!-- Yüklü Paket Uyarı Kartı (Metin içermeyen ses/grafik chunk paketi) -->
                                <Border Classes="infobar-warning" IsVisible="{Binding IsEmptyArchive}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="📦" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LoadedPakFileName}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#FFB74D"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding LoadedPakFileName}"/>
                                            <Border Grid.Column="2" Background="#26FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LoadedPakSizeInfo}" FontSize="10" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                            </Border>
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Classes="subtle"
                                                    Padding="6,2"
                                                    FontSize="12"
                                                    Foreground="#FF6B6B"
                                                    Command="{Binding CloseCurrentFileCommand}"
                                                    ToolTip.Tip="Mevcut paketi kapat"/>
                                        </Grid>
                                        <TextBlock Text="⚠️ Bu arşivde çevrilebilir metin (.locres vb.) bulunamadı (Yalnızca görsel/ses varlıkları içeriyor)."
                                                   FontSize="11" Foreground="#FFE082" TextWrapping="Wrap"/>
                                        <Button Content="➕  Dışarıdan Metin Dosyası Ekle (.locres, .json)"
                                                Classes="secondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="0,6"
                                                FontSize="11"
                                                Command="{Binding AddExternalFileCommand}"
                                                ToolTip.Tip="Bu arşivle eşleştirmek istediğiniz harici bir çeviri dosyasını seçin."/>
                                    </StackPanel>
                                </Border>

                                <!-- Henüz Yüklenmedi Kartı (WinUI 3 DragDrop Zone) -->
                                <Border Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding !IsPakLoaded}" DragDrop.AllowDrop="True">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Pak_NoPakLoaded}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Pak_DragDropTip}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Paket YÜKLÜ DEĞİLKEN: Ana Büyük Aç Butonları -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding !IsPakLoaded}">
                                    <Button Grid.Column="0" Content="{loc:Loc Pak_OpenPakBtn}"
                                            Classes="accent"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,9"
                                            Command="{Binding OpenPakCommand}"
                                            IsEnabled="{Binding !IsTranslating}"
                                            ToolTip.Tip="Yeni bir .pak arşivi açar."/>
                                    <Button Grid.Column="1" Content="{loc:Loc Pak_OpenFileBtn}"
                                            Classes="secondary"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,9"
                                            Command="{Binding OpenSingleFileCommand}"
                                            IsEnabled="{Binding !IsTranslating}"
                                            ToolTip.Tip="Doğrudan .locres, .json, .csv, .xml veya .po dosyasını açar."/>
                                </Grid>

                                <!-- Paket YÜKLÜ VE DOSYA VARKEN: Hızlı Dosya Listesi (WinUI 3 Fluent ListBox) -->
                                <Border Classes="card" Padding="10" IsVisible="{Binding HasLocalizationFiles}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="caption" Text="Lokalizasyon Dosyaları:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="💡 Rehber"
                                                        Classes="tool-btn"
                                                        Padding="7,3"
                                                        FontSize="10"
                                                        Click="OnLocalizationGuideClick"
                                                        ToolTip.Tip="Hangi dosyayı çevirmeliyim? Game.locres vs Engine.locres öğreticisini aç"/>
                                                <Border Background="#26FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PakEntries.Count, StringFormat='{}{0} dosya'}" FontSize="10" Foreground="#A0A0A0"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Sekmeli Dil ve Dosya Filtresi (Oyun Dilleri / Motor / Tümü) -->
                                        <Border Background="#1C1C1C" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <TabControl SelectedIndex="{Binding SelectedArchiveFilterIndex}">
                                                <TabControl.Styles>
                                                    <Style Selector="TabControl">
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                    <Style Selector="TabItem">
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Padding" Value="8,4"/>
                                                        <Setter Property="MinHeight" Value="26"/>
                                                    </Style>
                                                </TabControl.Styles>
                                                <TabItem Header="🌐 Oyun Dilleri (Game)"/>
                                                <TabItem Header="⚙️ Motor (Engine)"/>
                                                <TabItem Header="📁 Tümü"/>
                                            </TabControl>
                                        </Border>

                                        <!-- Hızlı Rehber İpucu Kutusu -->
                                        <Border Background="#1400B4D8" BorderBrush="#3300B4D8" BorderThickness="1" CornerRadius="5" Padding="7,5">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0" Text="💡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="İpucu: Türkçe yama için daima 🌐 Oyun Dilleri sekmesindeki ⭐ İngilizce (en) dosyasını seçin."
                                                           FontSize="10" Foreground="#4CC2FF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Şık Liste: Tıklanan dosya anında sağdaki tabloya yüklenir -->
                                        <ListBox ItemsSource="{Binding FilteredPakEntries}"
                                                 SelectedItem="{Binding SelectedPakEntry}"
                                                 MaxHeight="260"
                                                 Background="#161616"
                                                 BorderBrush="{DynamicResource CardStrokeBrush}"
                                                 BorderThickness="1"
                                                 CornerRadius="6"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2,4">
                                                        <TextBlock Grid.Column="0" Text="{Binding FileIcon}" FontSize="18" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding VirtualPath}"/>
                                                            <TextBlock Text="{Binding DirectoryPath}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding VirtualPath}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Ekle & Kaldır Butonları (Ferah, Geniş, Net) -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,2,0,0">
                                            <Button Grid.Column="0" Content="➕  Dosya / .pak Ekle"
                                                    Classes="secondary"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="0,7"
                                                    FontSize="11"
                                                    Command="{Binding AddExternalFileCommand}"
                                                    ToolTip.Tip="Mevcut listeye dışarıdan bir .pak veya .locres, .json, .csv dosyası ekler."/>
                                            <Button Grid.Column="1" Content="🗑️  Listeden Kaldır"
                                                    Classes="subtle"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="0,7"
                                                    FontSize="11"
                                                    Foreground="#FF8A80"
                                                    Command="{Binding RemoveSelectedArchiveFileCommand}"
                                                    ToolTip.Tip="Seçili olan dosyayı listeden kaldırır."/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Hızlı Dışa Aktarma & Çıktı Kartı (Sadece metin dosyası varsa görünür) -->
                                <Border Classes="card" Padding="12" IsVisible="{Binding HasLocalizationFiles}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="caption" Text="Çıktı &amp; Yamalama Eylemleri" FontWeight="SemiBold"/>
                                        <Button Content="🚀  Orijinal İsimle Çıktı Al"
                                                Classes="success"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding ExportToTimestampedFolderCommand}"
                                                ToolTip.Tip="Orijinal dosya adıyla (örn. English.pak) tarihli izole bir klasöre kaydeder."/>
                                        <Button Content="📂  Çıktı Klasörünü Aç"
                                                Classes="secondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding OpenOutputFolderCommand}"
                                                IsEnabled="{Binding HasExportedDirectory}"/>
                                        <Button Content="📦  Yama Paketi (_P.pak)"
                                                Classes="secondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding ExportPatchCommand}"
                                                ToolTip.Tip="Sadece çevrilen dosyaları içeren hafif mod yaması üretir."/>
                                    </StackPanel>
                                </Border>

                                <!-- Paket Yüklüyken: Farklı Arşiv / Dosya Aç Butonları -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding IsPakLoaded}">
                                    <Button Grid.Column="0" Content="🔄  Farklı .pak Aç"
                                            Classes="subtle"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,7"
                                            FontSize="11"
                                            Command="{Binding OpenPakCommand}"
                                            IsEnabled="{Binding !IsTranslating}"
                                            ToolTip.Tip="Başka bir .pak arşivi açar."/>
                                    <Button Grid.Column="1" Content="📄  Farklı Dosya Aç"
                                            Classes="subtle"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,7"
                                            FontSize="11"
                                            Command="{Binding OpenSingleFileCommand}"
                                            IsEnabled="{Binding !IsTranslating}"
                                            ToolTip.Tip="Başka bir tekil lokalizasyon dosyası açar."/>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Sekme 2: Arşiv İçeriği (Dosya Ağacı) -->
                    <TabItem Header="{loc:Loc Tab_ArchiveFiles}">
                        <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,6">
                                <TextBlock Classes="caption" Text="Lokalizasyon Dosyaları" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PakEntries.Count, StringFormat='{}{0} dosya'}"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding PakEntries}"
                                     SelectedItem="{Binding SelectedPakEntry}"
                                     Background="#1B1B1B"
                                     BorderBrush="{DynamicResource CardStrokeBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="📄" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding VirtualPath}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding VirtualPath}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,8,0,0">
                                <Button Grid.Column="0" Content="➕  Dosya Ekle"
                                        Classes="secondary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,7"
                                        FontSize="11"
                                        Command="{Binding AddExternalFileCommand}"
                                        ToolTip.Tip="Listeye dışarıdan yeni bir .locres, .json, .csv vb. lokalizasyon dosyası ekler."/>
                                <Button Grid.Column="1" Content="🗑️  Seçileni Kaldır"
                                        Classes="subtle"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,7"
                                        FontSize="11"
                                        Foreground="#FF8A80"
                                        Command="{Binding RemoveSelectedArchiveFileCommand}"
                                        ToolTip.Tip="Seçili olan dosyayı listeden kaldırır."/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Sekme 3: AES Şifreleme Araçları -->
                    <TabItem Header="{loc:Loc Tab_AesKey}">
                        <ScrollViewer Margin="0,8,0,0">
                            <StackPanel Spacing="10">
                                <Border Background="#222222" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="caption" Text="🔑 AES-256 Şifreleme Anahtarı" FontWeight="SemiBold"/>
                                        <TextBox PlaceholderText="0x... (Gerekiyorsa)"
                                                 Text="{Binding AesKey}"
                                                 PasswordChar="•"
                                                 FontSize="12"/>
                                        <TextBlock Classes="caption" Text="Unreal Engine şifreli paketleri için gereklidir." Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="caption" Text="Canlı Oyun ve AI Araçları" FontWeight="SemiBold"/>
                                        <Button Content="🔑  AES Anahtar Havuzu (Key Vault)"
                                                Classes="accent"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Click="OnAesKeyVaultClick"
                                                ToolTip.Tip="Bilinen yüzlerce popüler oyunun hazır AES-256 şifre havuzu. Çevrimdışı hazır + buluttan tek tıkla güncellenir."/>
                                        <Button Content="🎮  Canlı Oyundan AES Çıkarıcı"
                                                Classes="secondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Click="OnRamAesExtractorClick"
                                                ToolTip.Tip="Açık oyunun RAM belleğini tarayarak AES anahtarını otomatik bulur."/>
                                        <Button Content="🤖  AI ile AES &amp; Motor Bul"
                                                Classes="secondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Click="OnAiAesAssistantClick"
                                                ToolTip.Tip="Yapay zekaya oyun adını sorarak motoru ve bilinen AES anahtarını aratın."/>
                                        <Button Content="❓  AES Anahtarı Nedir?"
                                                Classes="subtle"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Click="OnAesHelpClick"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- ─── AYIRICI ÇİZGİ (DIVIDER) ─── -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource DividerBrush}"/>

            <!-- ─── SAĞ PANEL (WINUI 3 SEKMELİ MERKEZİ ÇALIŞMA ALANI) ─── -->
            <Border Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}" Padding="12,8">
                <TabControl>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SEKME 1: ÇEVİRİ TABLOSU & EDİTÖR                                 -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="{loc:Loc Tab_TranslationEditor}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">

                            <!-- ─── 1. COMMANDBAR (KOMUT & FİLTRE ÇUBUĞU) ─── -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <StackPanel Spacing="10">

                                    <!-- 1. Katman: Arama Kutusu (Esnek), Durum Filtresi, Diller & Birincil Yürütme Butonları -->
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">

                                        <!-- Arama Kutusu (Kalan Tüm Alanı Doldurur ve Esner) -->
                                        <TextBox Grid.Column="0"
                                                 PlaceholderText="{loc:Loc Grid_SearchPlaceholder}"
                                                 Text="{Binding FilterText}"
                                                 MinWidth="130"/>

                                        <!-- Gelişmiş Durum Filtresi (Dropdown) -->
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{x:Static vm:MainViewModel.StatusFilterOptions}"
                                                  SelectedItem="{Binding SelectedStatusFilter}"
                                                  Width="135"
                                                  ToolTip.Tip="Durum Filtresi (Tümü / Bekleyenler / Tamamlananlar / Hatalar / Manuel / Taşma Riski / QA Hataları)"/>

                                        <!-- X ➔ X Dil Seçici Çifti -->
                                        <Border Grid.Column="2" Background="#242424" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <ComboBox ItemsSource="{x:Static vm:MainViewModel.SourceLanguages}"
                                                          SelectedItem="{Binding SelectedSourceLanguage}"
                                                          Width="110" ToolTip.Tip="Kaynak Dil"/>
                                                <TextBlock Text="➔" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentHoverBrush}"/>
                                                <ComboBox ItemsSource="{x:Static vm:MainViewModel.TargetLanguages}"
                                                          SelectedItem="{Binding SelectedTargetLanguage}"
                                                          Width="105" ToolTip.Tip="Hedef Dil"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Birincil Çeviri Yürütme Butonları (Sabit Konumlu Dinamik Akıllı CTA) -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                                            <!-- 1. DOSYA YÜKLENMEMİŞKEN: Buton hep oradadır, deaktif tondadır ama basılabilir (Dosya seçtirir) -->
                                            <Button Content="{loc:Loc Grid_Btn_Start}"
                                                    Classes="play-inactive"
                                                    Command="{Binding PrimaryActionCommand}"
                                                    IsVisible="{Binding ShowInactiveStartButton}"
                                                    Padding="16,7"
                                                    ToolTip.Tip="Önce bir oyun veya yerelleştirme dosyası (.pak, .locres vb.) açmak için tıklayın"/>

                                            <!-- 2. DOSYA YÜKLÜ VE BOŞTAYKEN: Canlı Mavi Başlat Butonu -->
                                            <Button Content="{loc:Loc Grid_Btn_Start}"
                                                    Classes="play-primary"
                                                    Command="{Binding PrimaryActionCommand}"
                                                    IsVisible="{Binding ShowActiveStartButton}"
                                                    Padding="16,7"
                                                    ToolTip.Tip="Tüm liste için yapay zeka çevirisini başlatır (F5)"/>

                                            <!-- 3. ÇEVİRİ AKARKEN: Aynı noktada beliren Canlı Turuncu Durdur/Duraklat Butonu -->
                                            <Button Content="{loc:Loc Grid_Btn_Stop}"
                                                    Classes="pause-action"
                                                    Command="{Binding PrimaryActionCommand}"
                                                    IsVisible="{Binding ShowPauseButton}"
                                                    Padding="16,7"
                                                    ToolTip.Tip="Devam eden çeviriyi duraklatır (kaldığı yer korunur) (F5)"/>

                                            <!-- 4. DURAKLATILDIĞINDA: Aynı noktada beliren Canlı Mor/Mavi Devam Et Butonu -->
                                            <Button Content="{loc:Loc Grid_Btn_Resume}"
                                                    Classes="resume-primary"
                                                    Command="{Binding PrimaryActionCommand}"
                                                    IsVisible="{Binding ShowResumeButton}"
                                                    Padding="16,7"
                                                    ToolTip.Tip="Kaldığı yerden çeviriye devam eder (F5)"/>

                                            <!-- 5. İPTAL ET BUTONU: SADECE çeviri çalışırken veya duraklatılmışken YANINDA belirir -->
                                            <Button Content="{loc:Loc Menu_Trans_Cancel}"
                                                    Classes="stop-danger"
                                                    Command="{Binding CancelTranslationCommand}"
                                                    IsVisible="{Binding IsCancelButtonVisible}"
                                                    Padding="14,7"
                                                    ToolTip.Tip="Devam eden veya duraklatılmış çeviriyi anında iptal eder ve sıfırlar (Esc)"/>

                                        </StackPanel>
                                    </Grid>

                                    <!-- 2. Katman: Tablo Seçim Araçları (Sol) ─── Esnek Boşluk (*) ─── Düzenleme & Kalite Araçları (Sağ) -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                                        <!-- Sol: Tablo Satır Seçimi ve Seçim Aksiyonları -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Seçim:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <Button Content="☑️  Tümü" Classes="tool-btn" Command="{Binding SelectAllFilteredCommand}" Padding="8,5" ToolTip.Tip="Görünen tüm satırları seç"/>
                                            <Button Content="⚠️  Hatalar" Classes="tool-btn" Command="{Binding SelectOnlyErrorsCommand}" Padding="8,5" Foreground="{DynamicResource ErrorBrush}" ToolTip.Tip="Yalnızca hatalı satırları seç"/>
                                            <Button Content="⬜  Kaldır" Classes="tool-btn" Command="{Binding DeselectAllCommand}" Padding="8,5" ToolTip.Tip="Tüm seçimleri temizle"/>

                                            <!-- Ayırıcı Çizgi -->
                                            <Rectangle Width="1" Height="16" Fill="{DynamicResource CardStrokeBrush}" Margin="4,0"/>

                                            <Button Content="✨  Seçilenleri Çevir"
                                                    Classes="tool-btn"
                                                    Command="{Binding TranslateSelectedCommand}"
                                                    Padding="9,5"
                                                    ToolTip.Tip="Yalnızca kutucukla seçtiğiniz satırları çevirir."/>

                                            <Button Content="🔄  Hatalıları Tekrar Dene"
                                                    Classes="tool-btn"
                                                    Command="{Binding RetryErrorsCommand}"
                                                    Foreground="{DynamicResource WarningBrush}"
                                                    Padding="9,5"
                                                    ToolTip.Tip="Yalnızca hata alan satırları yeniden dener."/>
                                        </StackPanel>

                                        <!-- Orta (Sütun 1): Otomatik Esneyen Boşluk (İki grubu güvenle birbirinden ayırır) -->

                                        <!-- Sağ: Bul/Değiştir, Kalite Kontrol (QA), Onarım ve Diff -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="🔍  Bul/Değiştir"
                                                    Classes="tool-btn"
                                                    Command="{Binding ToggleFindReplaceCommand}"
                                                    ToolTip.Tip="Toplu Bul ve Değiştir Paneli (Ctrl+H / Ctrl+F)"/>

                                            <Button Content="🛡️  QA (F7)"
                                                    Classes="tool-btn"
                                                    Command="{Binding RunQaCheckCommand}"
                                                    Foreground="{DynamicResource AccentHoverBrush}"
                                                    ToolTip.Tip="Eksik değişken ({0}, {PlayerName}) ve kapanmayan HTML etiketlerini tespit eder."/>

                                            <Button Content="🛠️  Onar"
                                                    Classes="tool-btn"
                                                    Command="{Binding AutoFixAllQaIssuesCommand}"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    ToolTip.Tip="Eksik değişken ve etiketleri otomatik olarak satır sonuna tamamlar."/>

                                            <Button Content="🔍  Diff"
                                                    Classes="tool-btn"
                                                    Click="OnInspectDiffClick"
                                                    ToolTip.Tip="Seçili satırı çift panelli pencerede detaylı inceler."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ─── 2. İÇERİK ALANI (RECOVERY + FIND/REPLACE + DATAGRID) ─── -->
                            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">

                                <!-- Olası Çökme/Elektrik Kesintisi Kurtarma Bildirimi -->
                                <Border Grid.Row="0" Background="#3B2608" BorderBrush="#E09F3E" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12,8"
                                        IsVisible="{Binding HasRecoverySession}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RecoverySessionInfo}" FontWeight="SemiBold" Foreground="#FBD38D" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="🔄  Oturumu Geri Yükle" Classes="accent" Command="{Binding RestoreRecoverySessionCommand}" Margin="0,0,8,0" Padding="10,4"/>
                                        <Button Grid.Column="3" Content="✕  Yok Say" Classes="secondary" Command="{Binding DismissRecoverySessionCommand}" Padding="8,4"/>
                                    </Grid>
                                </Border>

                                <!-- TOPLU BUL VE DEĞİŞTİR PANELİ -->
                                <Border Grid.Row="1" Background="#242424" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12,10"
                                        IsVisible="{Binding IsFindReplaceOpen}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" PlaceholderText="🔍 Aranacak kelime..." Text="{Binding FindText}"/>
                                            <TextBox Grid.Column="1" PlaceholderText="✏️ Yeni değer..." Text="{Binding ReplaceText}"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:MainViewModel.FindScopeOptions}" SelectedItem="{Binding FindScope}" Width="150"/>
                                            <Button Grid.Column="3" Content="Tümünü Değiştir" Classes="accent" Command="{Binding ReplaceAllCommand}" Padding="12,5" FontWeight="SemiBold"/>
                                            <Button Grid.Column="4" Content="Sonrakini Bul" Classes="secondary" Command="{Binding FindNextCommand}" Padding="10,5"/>
                                            <Button Grid.Column="5" Content="✕" Classes="secondary" Command="{Binding CloseFindReplaceCommand}" Padding="8,5" ToolTip.Tip="Paneli Kapat (Esc)"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="14">
                                            <CheckBox Grid.Column="0" Content="Büyük/Küçük Harf Duyarlı" IsChecked="{Binding MatchCase}"/>
                                            <CheckBox Grid.Column="1" Content="Tam Kelime" IsChecked="{Binding MatchWholeWord}"/>
                                            <CheckBox Grid.Column="2" Content="Regex" IsChecked="{Binding UseRegex}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FindResultInfo}" Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- DATAGRID ÇEVİRİ EDİTÖRÜ -->
                                <DataGrid Grid.Row="2"
                                          Name="EntriesDataGrid"
                                          ItemsSource="{Binding FilteredEntries}"
                                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                          Background="#181818"
                                          RowBackground="#181818"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource CardStrokeBrush}"
                                          CornerRadius="8"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          IsReadOnly="False"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          DoubleTapped="OnDataGridDoubleTapped"
                                          RowHeight="36">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📋  Kaynak Metni Kopyala" Command="{Binding CopySourceCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                            <MenuItem Header="📋  Çeviri Metnini Kopyala" Command="{Binding CopyTranslationCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                            <MenuItem Header="🔄  Orijinal Metni Çeviriye Aktar" Command="{Binding CopySourceToTranslationCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                            <Separator/>
                                            <MenuItem Header="✨  Bu Satırı Tek Başına Yeniden Çevir" Command="{Binding RetranslateSingleCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                            <MenuItem Header="🌐  Google Translate'de Aç..." Command="{Binding OpenInGoogleTranslateCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                            <MenuItem Header="🔍  Detaylı İncele (Diff / Yan Yana)..." Click="OnInspectDiffClick"/>
                                            <Separator/>
                                            <MenuItem Header="✓  Tamamlandı Olarak İşaretle" Command="{Binding MarkAsDoneCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                            <MenuItem Header="⏳  Bekliyor Olarak İşaretle" Command="{Binding MarkAsPendingCommand}" CommandParameter="{Binding SelectedEntry}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <!-- Seçim Kutucuğu -->
                                        <DataGridTemplateColumn Header="☑️" Width="44" IsReadOnly="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:LocalizationEntryViewModel">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Durum Rozeti (WinUI 3 Pill) & QA İkonu -->
                                        <DataGridTemplateColumn Header="{loc:Loc Grid_Col_Status}" Width="135" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:LocalizationEntryViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                        <Border CornerRadius="10" Padding="8,2" Margin="2,2"
                                                                Background="{Binding StatusColor}"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Canlı LQA Rozeti: renk = en ağır MQM önem derecesi, sayı = sorun adedi -->
                                                        <Border CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding QaBadgeColor}"
                                                                IsVisible="{Binding HasQaIssue}"
                                                                ToolTip.Tip="{Binding QaTooltip}"
                                                                ToolTip.ShowDelay="200">
                                                            <TextBlock Text="{Binding QaIssueCount, StringFormat='!{0}'}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Namespace -->
                                        <DataGridTextColumn Header="Namespace"
                                                            Binding="{Binding Namespace}"
                                                            Width="140"
                                                            IsReadOnly="True"
                                                            FontSize="12"
                                                            FontFamily="Cascadia Code, Consolas, monospace"/>

                                        <!-- Anahtar -->
                                        <DataGridTextColumn Header="{loc:Loc Grid_Col_Key}"
                                                            Binding="{Binding Key}"
                                                            Width="160"
                                                            IsReadOnly="True"
                                                            FontSize="12"
                                                            FontFamily="Cascadia Code, Consolas, monospace"/>

                                        <!-- Orijinal Kaynak Metin -->
                                        <DataGridTextColumn Header="{loc:Loc Grid_Col_Source}"
                                                            Binding="{Binding SourceText}"
                                                            Width="*"
                                                            IsReadOnly="True"
                                                            FontSize="13"/>

                                        <!-- Hedef Çeviri (Düzenlenebilir) -->
                                        <DataGridTextColumn Header="{loc:Loc Grid_Col_Translation}"
                                                            Binding="{Binding TranslatedText}"
                                                            Width="*"
                                                            IsReadOnly="False"
                                                            FontSize="13"/>

                                        <!-- Karakter Farkı / UI Taşma Analizi -->
                                        <DataGridTextColumn Header="Karakter / UI"
                                                            Binding="{Binding LengthInfo}"
                                                            Width="140"
                                                            IsReadOnly="True"
                                                            FontSize="11"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- ─── 3. ÇEVİRİ DİREKTİFİ KARTI ─── -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,8,0,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="📝" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Çeviri Direktifi:"
                                                   VerticalAlignment="Center"
                                                   Classes="caption"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding UserDirective}"
                                             PlaceholderText="Örnek: Oyun karanlık fantezi temalıdır, karakter konuşmaları epik ve arkaik Türkçe olsun..."
                                             MaxLines="2"
                                             AcceptsReturn="True"/>
                                </Grid>
                            </Border>

                            <!-- ─── 4. CANLI İLERLEME & İSTATİSTİK BARI ─── -->
                            <Border Grid.Row="3"
                                    Background="#242424"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,8,0,0"
                                    IsVisible="{Binding IsTranslating}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Classes="caption" FontWeight="SemiBold" Text="Yapay Zeka Çevirisi Sürüyor..."/>
                                        </StackPanel>

                                        <!-- Canlı Metrik Rozetleri -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Border Background="#1AFFFFFF" CornerRadius="4" Padding="8,2">
                                                <TextBlock Classes="caption" Text="{Binding ElapsedTime, StringFormat='⏱️ Geçen: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <Border Background="#1AFFFFFF" CornerRadius="4" Padding="8,2">
                                                <TextBlock Classes="caption" Text="{Binding EstimatedTimeRemaining, StringFormat='⏳ Kalan: {0}'}" Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#1AFFFFFF" CornerRadius="4" Padding="8,2">
                                                <TextBlock Classes="caption" Text="{Binding TranslationSpeed, StringFormat='⚡ Hız: {0}'}" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Yüzde Göstergesi -->
                                        <TextBlock Grid.Column="4" Classes="caption" FontWeight="Bold"
                                                   Text="{Binding TranslationProgress, StringFormat='{}{0:F0}%'}"
                                                   Foreground="{DynamicResource AccentHoverBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding TranslationProgress}" Maximum="100" Height="6"/>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SEKME 2: İSTATİSTİKLER & ÖZET ANALİZ                             -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="{loc:Loc Tab_StatsSummary}">
                        <ScrollViewer Margin="0,8,0,0">
                            <StackPanel Spacing="14">

                                <!-- Üst 4'lü KPI Kartları -->
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

                                    <!-- Kart 1: Toplam Satır -->
                                    <Border Grid.Column="0" Classes="card" Padding="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="📦 Toplam Satır" Classes="caption" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding TotalEntries}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Ayrıştırılmış metinler" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Kart 2: Tamamlanan -->
                                    <Border Grid.Column="1" Background="#142A19" BorderBrush="#236B36" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="✓ Tamamlanan" Classes="caption" Foreground="#81C784"/>
                                            <TextBlock Text="{Binding CompletedEntries}" FontSize="22" FontWeight="Bold" Foreground="#66BB6A"/>
                                            <TextBlock Text="{Binding CompletionPercentage, StringFormat='İlerleme: %{0}'}" FontSize="11" Foreground="#A5D6A7" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Kart 3: Bekleyen -->
                                    <Border Grid.Column="2" Background="#1A2533" BorderBrush="#1E4976" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="⏳ Bekleyen" Classes="caption" Foreground="#90CAF9"/>
                                            <TextBlock Text="{Binding PendingEntries}" FontSize="22" FontWeight="Bold" Foreground="#64B5F6"/>
                                            <TextBlock Text="Çevrilmeyi bekliyor" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Kart 4: Hata Alanlar -->
                                    <Border Grid.Column="3" Background="#331417" BorderBrush="#772027" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="✗ Hata Sayısı" Classes="caption" Foreground="#EF9A9A"/>
                                            <TextBlock Text="{Binding ErrorCount}" FontSize="22" FontWeight="Bold" Foreground="#E57373"/>
                                            <TextBlock Text="Yeniden denenebilir" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Hacim & Kalite Detay Kartları -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                    <!-- Sol: Hacim Analizi -->
                                    <Border Grid.Column="0" Classes="card" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="📝 Metin &amp; Dil Hacmi" Classes="heading"/>
                                            <Separator Background="{DynamicResource CardStrokeBrush}"/>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Kaynak Dil Kelime Sayısı:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalSourceWords, StringFormat='{}{0:N0} kelime'}" FontWeight="SemiBold"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Toplam Karakter Sayısı:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalSourceChars, StringFormat='{}{0:N0} karakter'}" FontWeight="SemiBold"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Manuel Düzenlenen Satırlar:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ManuallyEditedCount}" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Kaynak / Hedef Dil:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LanguagePairDisplay}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sağ: Risk & QA Durumu -->
                                    <Border Grid.Column="1" Classes="card" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="🛡️ Kalite &amp; Arayüz Taşma Riski" Classes="heading"/>
                                            <Separator Background="{DynamicResource CardStrokeBrush}"/>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Etiket / Değişken (QA) Uyarısı:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding QaIssueCount}" FontWeight="Bold" Foreground="#F59E0B"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Metin Taşma Riski (%40+ Fark):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding OverflowRiskCount}" FontWeight="Bold" Foreground="#EF4444"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="Aktif AI Çeviri Motoru:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedProviderName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="AI Akıl Yürütme Modu:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedReasoningEffort}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Hızlı Eylem Çubuğu -->
                                <Border Classes="card" Padding="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="⚡ Hızlı Eylemler:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="⏭️  Kaldığı Yerden Devam Et (F6)" Classes="accent" Command="{Binding ResumeTranslationCommand}"/>
                                        <Button Grid.Column="3" Content="🛠️  Eksikleri Onar" Classes="secondary" Command="{Binding AutoFixAllQaIssuesCommand}"/>
                                        <Button Grid.Column="4" Content="📥  CSV Olarak Çıkart" Classes="secondary" Command="{Binding ExportTranslationsCsvCommand}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SEKME 3: KALİTE KONTROL (QA) & BÜTÜNLÜK                         -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="{loc:Loc Tab_QaInspection}">
                        <ScrollViewer Margin="0,8,0,0">
                            <StackPanel Spacing="14">

                                <Border Classes="card" Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="🛡️ Oyun Yerelleştirme Kalite ve Bütünlük Kuralları" Classes="heading"/>
                                        <TextBlock Text="Oyun diyaloglarında kod değişkenlerinin ({0}, %s, {PlayerName}) silinmesi oyunun çökmesine yol açabilir. Bu denetim motoru tüm satırları tarar." Classes="caption"/>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                                    <Border Grid.Column="0" Classes="card" Padding="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="📌 Kod Değişkenleri" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding QaIssueCount, StringFormat='{}{0} sorun tespit edildi'}" Foreground="#F59E0B" FontWeight="Bold"/>
                                            <TextBlock Text="{}{0}, %s, {PlayerName}, [VAR_X] etiketlerinin korunumu." Classes="caption"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Classes="card" Padding="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="🎨 HTML &amp; Renk Etiketleri" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Etiket Çiftleri Doğrulandı" Foreground="#10B981" FontWeight="Bold"/>
                                            <TextBlock Text="Kapanmayan &lt;color&gt;, &lt;font&gt; veya BBCode etiketleri taranır." Classes="caption"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Classes="card" Padding="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="📐 Arayüz Alan Taşması" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding OverflowRiskCount, StringFormat='{}{0} satır riskli'}" Foreground="#EF4444" FontWeight="Bold"/>
                                            <TextBlock Text="Orijinalinden %40 daha uzun metinler butonlardan taşabilir." Classes="caption"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Otomatik Onarım & Aksiyonlar -->
                                <Border Background="#1C2735" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="🛠️ Otomatik Değişken ve Etiket Tamamlayıcı" FontWeight="Bold" FontSize="14" Foreground="#93C5FD"/>
                                            <TextBlock Text="Eksik kalan veya yapay zekanın unuttuğu değişkenleri otomatik olarak çevirinin sonuna ekler." Classes="caption" Foreground="#BFDBFE"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🛡️  QA Tara (F7)" Classes="secondary" Command="{Binding RunQaCheckCommand}" Padding="16,8"/>
                                        <Button Grid.Column="2" Content="🛠️  Tümünü Otomatik Onar" Classes="accent" Command="{Binding AutoFixAllQaIssuesCommand}" Padding="16,8"/>
                                    </Grid>
                                </Border>

                                <Border Classes="card" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Hatalı ve Sorunlu Satır Raporu" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tüm hata alan ve QA uyarısı veren satırları Excel / CSV formatında detaylıca dışa aktarın." Classes="caption"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚠️  Hata Raporu Al (CSV)" Classes="secondary" Command="{Binding ExportErrorsCsvCommand}" Padding="14,8"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- SEKME 4: ÇEVİRİ BELLEĞİ (TM) & SÖZLÜK                           -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="{loc:Loc Tab_MemoryGlossary}">
                        <ScrollViewer Margin="0,8,0,0">
                            <StackPanel Spacing="14">

                                <!-- Çeviri Belleği (Translation Memory) -->
                                <Border Classes="card" Padding="16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="🧠 Çeviri Belleği (Translation Memory &amp; Önbellek)" Classes="heading"/>
                                                <TextBlock Text="Daha önce çevrilmiş birebir aynı cümleleri yerel diskte hatırlar ve tekrar API ücreti/kotası harcamaz." Classes="caption"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Belleği Etkinleştir" IsChecked="{Binding EnableTranslationMemory}"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource CardStrokeBrush}"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Önbelleğe alınmış çevirileri diskten temizlemek için:" VerticalAlignment="Center" Classes="caption"/>
                                            <Button Grid.Column="1" Content="🗑️  Çeviri Belleğini Temizle" Classes="secondary" Command="{Binding ClearTranslationMemoryCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Özel İsimler & Terimler Sözlüğü -->
                                <Border Classes="card" Padding="16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="📖 Özel İsimler &amp; Terimler Sözlüğü (Glossary)" Classes="heading"/>
                                                <TextBlock Text="Oyun karakterleri, şehirler, özel terimler veya çevrilmemesi gereken isimler." Classes="caption"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="📚  Sözlüğü Aç..." Classes="accent" Click="OnGlossaryClick"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource CardStrokeBrush}"/>
                                        <TextBlock Text="{Binding GlossaryList.Count, StringFormat='Aktif Sözlük Girdisi: {0} adet kural yüklü.'}" Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>

        </Grid>

        <!-- ─── 3. WINUI 3 DURUM ÇUBUĞU (FOOTER STATUS BAR) ─── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Classes="caption"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="8,2">
                        <TextBlock Classes="caption" Text="{Binding TotalEntries, StringFormat='📦 Toplam: {0}'}"/>
                    </Border>
                    <Border Background="#19391D" CornerRadius="4" Padding="8,2">
                        <TextBlock Classes="caption" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Text="{Binding CompletedEntries, StringFormat='✓ {0} Tamamlandı'}"/>
                    </Border>
                    <Border Background="#441A1E" CornerRadius="4" Padding="8,2">
                        <TextBlock Classes="caption" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" Text="{Binding ErrorCount, StringFormat='✗ {0} Hata'}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
