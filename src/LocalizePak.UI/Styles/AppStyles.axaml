<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataGrid Teması -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 / WINDOWS 11 FLUENT 2 TEMEL TİPOGRAFİ                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 / FLUENT 2 BUTON STİLLERİ                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- WinUI 3 Vurgu Butonu (Accent Button) -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="#0A0A0A"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ─── YENİ: DİNAMİK CANLI BİRİNCİL ÇEVİRİ BAŞLAT BUTONU (CANLI GRADIENT) ─── -->
    <Style Selector="Button.play-primary">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0078D4" Offset="0.0"/>
                <GradientStop Color="#00B4D8" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.play-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0086E8" Offset="0.0"/>
                <GradientStop Color="#00C8F0" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
    </Style>
    <Style Selector="Button.play-primary:pressed /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#005A9E" Offset="0.0"/>
                <GradientStop Color="#008EB0" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ─── YENİ: DOSYA YÜKLENMEMİŞKEN BAŞLAT BUTONU (PASİF/DEAKTİF TON, AMA BASILABİLİR) ─── -->
    <Style Selector="Button.play-inactive">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="Foreground" Value="#888888"/>
        <Setter Property="BorderBrush" Value="#383838"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.play-inactive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#323232"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
    <Style Selector="Button.play-inactive:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#1F1F1F"/>
        <Setter Property="Foreground" Value="#999999"/>
    </Style>

    <!-- ─── YENİ: DİNAMİK DURDUR/DURAKLAT BUTONU (CANLI TURUNCU/KEHRİBAR GRADİENT) ─── -->
    <Style Selector="Button.pause-action">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#D83B01" Offset="0.0"/>
                <GradientStop Color="#EA5E00" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.pause-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#EA5E00" Offset="0.0"/>
                <GradientStop Color="#FF7828" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
    </Style>
    <Style Selector="Button.pause-action:pressed /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#B83000" Offset="0.0"/>
                <GradientStop Color="#C94F00" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ─── YENİ: DİNAMİK KALDIĞI YERDEN DEVAM ET BUTONU (İNDİGO / MOR GRADİENT) ─── -->
    <Style Selector="Button.resume-primary">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#5B5FC7" Offset="0.0"/>
                <GradientStop Color="#0078D4" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.resume-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#6E73E6" Offset="0.0"/>
                <GradientStop Color="#0086E8" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
    </Style>
    <Style Selector="Button.resume-primary:pressed /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#4A4E9E" Offset="0.0"/>
                <GradientStop Color="#005A9E" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ─── YENİ: DİNAMİK DURDUR BUTONU (CANLI PARLAYAN KIRMIZI / CRITICAL GRADIENT) ─── -->
    <Style Selector="Button.stop-danger">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#D13438" Offset="0.0"/>
                <GradientStop Color="#A4262C" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.stop-danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#E81123" Offset="0.0"/>
                <GradientStop Color="#C42B1C" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
    </Style>
    <Style Selector="Button.stop-danger:pressed /template/ ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#A4262C" Offset="0.0"/>
                <GradientStop Color="#77191E" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.stop-danger:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="BorderBrush" Value="#333333"/>
    </Style>

    <!-- ─── YENİ: MODERN ARAÇ BUTONU (TOOL BUTTON: QA, DİFF, BUL/DEĞİŞTİR VB.) ─── -->
    <Style Selector="Button.tool-btn">
        <Setter Property="Background" Value="#222222"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="BorderBrush" Value="#383838"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tool-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#303030"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
    <Style Selector="Button.tool-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="BorderBrush" Value="#303030"/>
    </Style>

    <!-- WinUI 3 Standart Buton (Default Button) -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="#2E2E2E"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A3A3A"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#252525"/>
    </Style>

    <!-- WinUI 3 Hafif / Subtle Buton (Transparent / Flat) -->
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.subtle:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>

    <!-- WinUI 3 Başarılı Buton (Success Action) -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="#0F7B3E"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14944B"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#0A5B2D"/>
    </Style>

    <!-- WinUI 3 Tehlike / İptal Butonu (Critical Button) -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#441A1E"/>
        <Setter Property="Foreground" Value="#FFA8B2"/>
        <Setter Property="BorderBrush" Value="#4DFF99A4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#5C2025"/>
        <Setter Property="Foreground" Value="#FFCCD2"/>
        <Setter Property="BorderBrush" Value="#80FF99A4"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#331417"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 KART VE KATMAN STİLLERİ                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Border.settings-card">
        <Setter Property="Background" Value="#282828"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style Selector="Border.infobar-success">
        <Setter Property="Background" Value="#142C1B"/>
        <Setter Property="BorderBrush" Value="#2E7D32"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.infobar-warning">
        <Setter Property="Background" Value="#2C200C"/>
        <Setter Property="BorderBrush" Value="#B45309"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.infobar-error">
        <Setter Property="Background" Value="#2C1215"/>
        <Setter Property="BorderBrush" Value="#B91C1C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 TİPOGRAFİ                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 FORM KONTROLLERİ                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#262626"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Background" Value="#1E1E1E"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#262626"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="#303030"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 LİSTE VE DATAGRID KONTROLLERİ                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2E2E"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="#222222"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="#242424"/>
    </Style>

    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="#2D2D2D"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#262626"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WINUI 3 / FLUENT 2 TABCONTROL & TABITEM                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

</Styles>
