<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);MSB3246</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalizePak.Core\LocalizePak.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202610" />
    <!-- CUE4Parse geçişli olarak açıklı Microsoft.Bcl.Memory 9.0.0 getiriyor (GHSA-73j8-2gch-69rq); yamalı sürüme sabitlenir -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
